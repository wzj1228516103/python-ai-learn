# 大模型访问密钥；真实值只放在 .env，不要提交到 Git。
OPENAI_API_KEY=your_dashscope_api_key
# OpenAI 兼容接口地址，当前默认使用阿里云 DashScope。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 支持 Chat Completions、function calling 和流式输出的模型名称。
MODEL_NAME=qwen-plus
# 百度搜索和来源网页读取的单次 HTTP 超时时间，单位为秒。
REQUEST_TIMEOUT_SECONDS=20
# 模型与工具一次问答最多往返次数，防止无限循环。
MAX_TOOL_ROUNDS=6
